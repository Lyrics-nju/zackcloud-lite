{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zackcloud-lite",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "env": {
    "staging": {
      "name": "zackcloud-lite-staging",
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "zackcloud-auth",
          "database_id": "d2cec84f-1945-4e00-a235-f6a647799c70"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SUBSCRIPTION_STORE",
          "id": "5aae504939bb46289a56c41a92014690"
        }
      ],
      "routes": [
        {
          "pattern": "sub-staging.zackcloud.site",
          "custom_domain": true
        }
      ]
    }
  }
}
