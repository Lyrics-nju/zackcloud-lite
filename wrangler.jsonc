{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zackcloud-lite",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "env": {
    "staging": {
      "name": "zackcloud-lite-staging",
      "kv_namespaces": [
        {
          "binding": "SUBSCRIPTION_STORE",
          "id": "5aae504939bb46289a56c41a92014690"
        }
      ]
    }
  }
}
