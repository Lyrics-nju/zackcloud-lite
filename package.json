{
  "name": "zackcloud-lite",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "security:scan": "node scripts/security-scan.mjs",
    "security-scan": "node scripts/security-scan.mjs",
    "update:dry-run": "tsx scripts/update-subscription.ts --dry-run --source=local",
    "update:local": "tsx scripts/update-subscription.ts --source=local",
    "update:ci": "tsx scripts/update-subscription.ts --source=env",
    "setup:kv": "tsx scripts/setup-kv.ts",
    "verify:staging": "tsx scripts/verify-staging.ts",
    "friend:add": "tsx scripts/friends.ts add",
    "friend:list": "tsx scripts/friends.ts list",
    "friend:disable": "tsx scripts/friends.ts disable",
    "friend:enable": "tsx scripts/friends.ts enable",
    "friend:rotate": "tsx scripts/friends.ts rotate",
    "friend:remove": "tsx scripts/friends.ts remove",
    "friend:expire": "tsx scripts/friends.ts expire",
    "friends:deploy": "tsx scripts/friends.ts deploy",
    "friends:migrate-staging": "tsx scripts/friends.ts migrate-staging",
    "friend:add-and-deploy": "tsx scripts/friends.ts add-and-deploy",
    "friend:verify": "tsx scripts/friends.ts verify",
    "portal:dev": "wrangler dev --config portal/wrangler.jsonc --local",
    "portal:test": "vitest run test/portal*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply AUTH_DB --local --config portal/wrangler.jsonc",
    "admin:hash-password": "tsx scripts/admin-hash-password.ts",
    "deploy:dry-run": "wrangler deploy --dry-run --env staging --outdir dist/subscription && wrangler deploy --dry-run --config portal/wrangler.jsonc --outdir ../dist/portal"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "latest",
    "@eslint/js": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "tsx": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
