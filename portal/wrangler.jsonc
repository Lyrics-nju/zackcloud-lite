{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zackcloud-portal",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "zackcloud-auth-local",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ]
}
