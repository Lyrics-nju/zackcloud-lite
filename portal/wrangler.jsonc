{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zackcloud-portal-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "zackcloud-auth",
      "database_id": "d2cec84f-1945-4e00-a235-f6a647799c70",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "USER_LOGIN_RATE_LIMITER",
      "namespace_id": "6061001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LOGIN_RATE_LIMITER",
      "namespace_id": "6061002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "portal-staging.zackcloud.site",
      "custom_domain": true
    }
  ]
}
