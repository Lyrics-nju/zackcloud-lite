{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zackcloud-portal",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ZACKCLOUD_PUBLIC_BASE_URL": "https://sub.zackcloud.site"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "zackcloud-auth-prod",
      "database_id": "57099dea-7d75-4d00-9a8b-af5c088ec122",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "USER_LOGIN_RATE_LIMITER",
      "namespace_id": "6070001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LOGIN_RATE_LIMITER",
      "namespace_id": "6070002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "zackcloud.site",
      "custom_domain": true
    }
  ]
}
